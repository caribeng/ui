{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "../../../dist/packages/ui/schematics"
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
