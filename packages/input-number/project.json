{
  "name": "input-number",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/input-number/src",
  "tags": [
    "type:lib",
    "scope:input-number"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/packages/input-number"
      ],
      "options": {
        "project": "packages/input-number/ng-package.json",
        "tsConfig": "packages/input-number/tsconfig.lib.json"
      }
    },
    "build-test": {
      "executor": "@angular/build:ng-packagr",
      "options": {
        "project": "packages/input-number/ng-package.json",
        "tsConfig": "packages/input-number/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/input-number"
      ],
      "options": {
        "buildTarget": "input-number:build-test",
        "tsConfig": "packages/input-number/tsconfig.spec.json",
        "runner": "vitest",
        "watch": false
      }
    }
  }
}
