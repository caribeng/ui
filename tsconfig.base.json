{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "useDefineForClassFields": false,
    "paths": {
      "@caribeng/ui": ["./packages/ui/src/public-api.ts"],
      "@caribeng/ui/icon": ["./packages/ui/icon/src/public-api.ts"],
      "@caribeng/ui/icons": ["./packages/ui/icons/src/public-api.ts"],
      "@caribeng/ui/button": ["./packages/ui/button/src/public-api.ts"],
      "@caribeng/ui/input": ["./packages/ui/input/src/public-api.ts"],
      "@caribeng/ui/select": ["./packages/ui/select/src/public-api.ts"],
      "@caribeng/ui/dialog": ["./packages/ui/dialog/src/public-api.ts"],
      "@caribeng/ui/toast": ["./packages/ui/toast/src/public-api.ts"],
      "@caribeng/ui/textarea": ["./packages/ui/textarea/src/public-api.ts"],
      "@caribeng/ui/checkbox": ["./packages/ui/checkbox/src/public-api.ts"],
      "@caribeng/ui/radio": ["./packages/ui/radio/src/public-api.ts"],
      "@caribeng/ui/toggle": ["./packages/ui/toggle/src/public-api.ts"],
      "@caribeng/ui/input-number": ["./packages/ui/input-number/src/public-api.ts"],
      "@caribeng/ui/autocomplete": ["./packages/ui/autocomplete/src/public-api.ts"],
      "@caribeng/ui/datepicker": ["./packages/ui/datepicker/src/public-api.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
