{
  "name": "showcase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/showcase/src",
  "tags": ["type:app", "scope:showcase"],
  "targets": {
    "doc-code": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/app/pages/**/*.ts",
        "{projectRoot}/scripts/gen-doc-code.mjs",
        "{workspaceRoot}/packages/ui/**/*.ts"
      ],
      "outputs": ["{projectRoot}/public/doc-code.json"],
      "options": {
        "command": "node apps/showcase/scripts/gen-doc-code.mjs"
      }
    },
    "changelog": {
      "executor": "nx:run-commands",
      "inputs": ["{workspaceRoot}/CHANGELOG.md", "{projectRoot}/scripts/gen-changelog.mjs"],
      "outputs": ["{projectRoot}/src/app/data/changelog.generated.ts"],
      "options": {
        "command": "node apps/showcase/scripts/gen-changelog.mjs"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{workspaceRoot}/dist/apps/showcase"],
      "options": {
        "outputPath": "dist/apps/showcase",
        "index": "apps/showcase/src/index.html",
        "browser": "apps/showcase/src/main.ts",
        "tsConfig": "apps/showcase/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/showcase/public"
          },
          {
            "glob": "pdf.worker.min.mjs",
            "input": "node_modules/pdfjs-dist/build",
            "output": "pdfjs/build"
          },
          {
            "glob": "**/*",
            "input": "node_modules/pdfjs-dist/cmaps",
            "output": "pdfjs/cmaps"
          },
          {
            "glob": "**/*",
            "input": "node_modules/pdfjs-dist/standard_fonts",
            "output": "pdfjs/standard_fonts"
          },
          {
            "glob": "**/*",
            "input": "node_modules/pdfjs-dist/wasm",
            "output": "pdfjs/wasm"
          },
          {
            "glob": "**/*",
            "input": "node_modules/pdfjs-dist/iccs",
            "output": "pdfjs/iccs"
          }
        ],
        "styles": [
          "node_modules/@angular/cdk/overlay-prebuilt.css",
          "apps/showcase/src/styles.scss"
        ],
        "allowedCommonJsDependencies": ["prismjs"]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production",
      "dependsOn": ["doc-code", "changelog"]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "showcase:build:development",
        "port": 4200
      }
    }
  }
}
