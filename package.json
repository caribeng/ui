{
  "name": "@caribeng/source",
  "version": "1.0.0",
  "description": "CaribeNG — Sistema de diseño y librería de componentes Angular, independiente de terceros.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "build:libs": "nx run-many -t build --projects=tag:type:lib",
    "test": "nx run-many -t test",
    "test:coverage": "nx test ui --coverage",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p packages/ui/tsconfig.lib.json --noEmit && node ./node_modules/typescript/bin/tsc -p packages/ui/tsconfig.spec.json --noEmit && node ./node_modules/typescript/bin/tsc -p apps/showcase/tsconfig.app.json --noEmit",
    "pack:verify": "npm pack --dry-run ./dist/packages/ui",
    "release:prepare": "nx run ui:prepare-publish",
    "lint": "nx run-many -t lint",
    "showcase": "nx serve showcase",
    "showcase:build": "nx build showcase",
    "docs:code": "node apps/showcase/scripts/gen-doc-code.mjs",
    "docs:changelog": "node apps/showcase/scripts/gen-changelog.mjs"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "22.2.3",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@nx/angular": "23.3.1",
    "@nx/eslint": "23.3.1",
    "@nx/js": "23.3.1",
    "@nx/vite": "23.3.1",
    "@nx/web": "23.3.1",
    "@nx/workspace": "23.3.1",
    "@schematics/angular": "22.0.5",
    "@types/node": "20.19.0",
    "@types/prismjs": "1.26.5",
    "jsdom": "^27.1.0",
    "ng-packagr": "22.0.1",
    "nx": "23.3.1",
    "pdfjs-dist": "6.4.299",
    "sass": "1.97.3",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "prismjs": "1.30.0",
    "rxjs": "~7.8.2",
    "zone.js": "0.16.3"
  }
}
