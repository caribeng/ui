{
  "name": "@caribeng/source",
  "version": "1.0.0",
  "description": "CaribeNG — Sistema de diseño y librería de componentes Angular, independiente de terceros.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "build:libs": "nx run-many -t build --projects=tag:type:lib",
    "test": "nx run-many -t test",
    "test:coverage": "nx test ui --coverage",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p packages/ui/tsconfig.lib.json --noEmit && node ./node_modules/typescript/bin/tsc -p packages/ui/tsconfig.spec.json --noEmit && node ./node_modules/typescript/bin/tsc -p apps/showcase/tsconfig.app.json --noEmit",
    "pack:verify": "npm pack --dry-run ./dist/packages/ui",
    "lint": "nx run-many -t lint",
    "showcase": "nx serve showcase",
    "showcase:build": "nx build showcase"
  },
  "devDependencies": {
    "@angular/build": "21.2.27",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@angular/language-service": "21.2.25",
    "@nx/angular": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@types/node": "20.19.0",
    "@types/prismjs": "1.26.5",
    "jsdom": "^27.1.0",
    "ng-packagr": "21.2.7",
    "nx": "23.1.0",
    "sass": "1.97.3",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "prismjs": "1.29.0",
    "rxjs": "~7.8.2",
    "zone.js": "0.16.2"
  }
}
